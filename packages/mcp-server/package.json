{
  "name": "browser-control-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "MCP server over stdio for browser-control: drive the browser the operator is already using, addressing pages by name.",
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs"
  },
  "bin": {
    "browser-control-mcp": "./bin/browser-control-mcp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/browser-control-mcp.mjs",
    "test": "node --test test/protocol.test.mjs"
  },
  "dependencies": {
    "browser-control": "0.1.0"
  },
  "license": "MIT",
  "author": "Bryce Chou <ByteAKA8bit@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteAKA8bit/browser-control-kit.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/ByteAKA8bit/browser-control-kit/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ByteAKA8bit/browser-control-kit/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome",
    "cdp",
    "browser-automation",
    "playwright",
    "agent"
  ],
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
